<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff8f0"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@mipmap/ic_launcher"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WhiskFul"
        android:textSize="28sp"
        android:textColor="#5c3317"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Plan it. Cook it. Love it."
        android:textSize="14sp"
        android:textColor="#8a5a2b"
        android:fontFamily="sans-serif"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Please enter your server URL below"
        android:textSize="14sp"
        android:textColor="#5c3317"
        android:fontFamily="sans-serif"
        android:background="#fff"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="2dp" />

    <EditText
        android:id="@+id/urlInput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.25"
        android:hint=""
        android:textColorHint="#a87c4f"
        android:textColor="#5c3317"
        android:background="@drawable/url_input_bg"
        android:padding="14dp"
        android:textSize="16sp"
        android:inputType="textUri"
        android:imeOptions="actionGo"
        android:layout_marginBottom="16dp"
        android:gravity="top|start"
        android:minHeight="0dp" />

    <Button
        android:id="@+id/connectBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save"
        android:textColor="#5c3317"
        android:textSize="16sp"
        android:backgroundTint="#d97706"
        android:layout_marginBottom="16dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(C) wickedyoda.com"
        android:textSize="12sp"
        android:textColor="#a87c4f"
        android:fontFamily="sans-serif" />

</LinearLayout>

<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="14490.70" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" useTraitInheritanceMasks="YES">
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="20147.70"/>
    </dependencies>
    <scenes>
        <scene code="view_controllers" title="Launch Screen" id="launch">
            <objects>
                <viewController id="vc" customClass="UIView" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" backgroundColorSystem="systemBackground">
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="logo_img">
                                <image name="AppIcon" width="200" height="233"/>
                            </imageView>
                        </subviews>
                        <constraints>
                            <constraint firstItem="logo_img" firstAttribute="centerX" secondItem="view" secondAttribute="centerX" id="c_x"/>
                            <constraint firstItem="logo_img" firstAttribute="centerY" secondItem="view" secondAttribute="centerY" id="c_y"/>
                        </constraints>
                    </view>
                </viewController>
            </objects>
        </scene>
    </scenes>
</document>
